      "name": "05. CRUD Admin Data Sensor (3 Requests)",
      "item": [
        {
          "name": "#26 - Admin: Tambah Data Sensor Baru (Injeksi HTTP POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/readings",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "readings"
              ],
              "query": []
            },
            "description": "Kriteria Pengujian: Body JSON tersimpan ke basis data; respons { success: true, id: <ID> }; langsung muncul di /latest & /logs.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"room\": \"lab_td\",\n  \"temperature\": 27.4,\n  \"humidity\": 58.2,\n  \"wind_speed\": 1.4,\n  \"co2\": 420,\n  \"fan_rpm\": 980,\n  \"relay_state\": \"ON\",\n  \"air_quality\": \"Baik\",\n  \"uptime\": 3600\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response contains success and new ID\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json).to.have.property(\"id\");",
                  "    ",
                  "    // Simpan ID yang baru dibuat ke environment variable Postman",
                  "    pm.environment.set(\"test_record_id\", json.id);",
                  "});"
                ]
              }
            }
          ]
        },
