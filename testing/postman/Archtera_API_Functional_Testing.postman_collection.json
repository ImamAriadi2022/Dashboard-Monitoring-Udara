      "name": "01. Status & Health (6 Requests)",
      "item": [
        {
          "name": "#1 - Health Check Backend & Koneksi Broker MQTT",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "status"
              ],
              "query": []
            },
            "description": "Kriteria Pengujian: JSON { status: \"online\", mqtt: { broker, topic, connected }, timestamp } valid dan waktu respons < 2000ms."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time is under 2000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "pm.test(\"Server is online and MQTT connected\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"online\");",
                  "    pm.expect(jsonData.mqtt).to.be.an(\"object\");",
                  "    pm.expect(jsonData.mqtt.connected).to.be.true;",
                  "    pm.expect(jsonData.timestamp).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ]
        },
